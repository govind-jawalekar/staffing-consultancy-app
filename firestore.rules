rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "admin";
    }

    function isHR() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "hr";
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /applications/{appId} {

        allow create: if request.auth != null &&
          request.resource.data.userId == request.auth.uid &&
          !exists(
            /databases/$(database)/documents/applications/
            $(request.auth.uid + "_" + request.resource.data.jobId)
          );

        allow read: if request.auth != null &&
          (request.auth.uid == resource.data.userId || isAdmin() || isHR());

        allow update, delete: if isAdmin() || isHR();
    }

    match /Users/{userId} {

      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());

      allow update: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());

      allow delete: if isAdmin();
    }
    match /feedbacks/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /reviews/{reviewID} {
      // Anyone can submit a review
      allow create: if true;

      // Anyone can read only if the review is approved
      allow read: if resource.data.status == "approved"|| isAdmin();

      // Only admin can update/delete
      allow  update, delete: if isAdmin();
    }
  }
}